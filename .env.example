# Copy to .env.local (gitignored) and adjust. Fully reload the app after changes.
# Defaults (when unset) are the production gateway.

# API gateway origin, no trailing path. REST calls go to <this>/api/v1/backend, socket to <this>/socket.
# Android emulator reaching a local gateway: http://10.0.2.2:8000
EXPO_PUBLIC_API_GATEWAY_URL=https://eazycrm-apigateway.scribbleandconnect.com

# Origin header for the socket handshake (must be allowed by the gateway CORS list).
EXPO_PUBLIC_SOCKET_ORIGIN=https://eazycrm.scribbleandconnect.com
