{
  "expo": {
    "name": "sac-mobile",
    "slug": "sac-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconsac1.png",
    "scheme": "sacmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.alidcoded.sacmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00326b",
          "image": "./assets/images/sac-splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0d1520",
            "image": "./assets/images/sac-splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-audio",
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80dd1fa0-9c3f-406c-a62d-ee35ec814db9"
      }
    },
    "owner": "ginger-technoogies"
  }
}
